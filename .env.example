# ─────────────────────────────────────────────────────────────
# MindMate NER — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file (it is gitignored).
# Vite only exposes variables prefixed with VITE_ to the client.
# ─────────────────────────────────────────────────────────────

# Supabase — from your project's API settings (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Groq — free key from https://console.groq.com/keys
# Restart `npm run dev` after adding it.
VITE_GROQ_API_KEY=your-groq-api-key
